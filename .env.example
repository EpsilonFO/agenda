# Clé API OpenAI — récupérable sur https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modèle unique : GPT-5.6 Terra partout (OPENAI_MODEL est le défaut global,
# surchargeable rôle par rôle si besoin). API Responses (/v1/responses).
OPENAI_MODEL=gpt-5.6-terra
# OPENAI_MODEL_PLANNER=
# OPENAI_MODEL_COACH=
# OPENAI_MODEL_WORK=
# OPENAI_MODEL_LEISURE=
# OPENAI_MODEL_CHEF=

# Effort de raisonnement appliqué à tous les appels : none|low|medium|high|xhigh|max.
# (xhigh = défaut sûr ; "max" à essayer, tous les tiers 5.6 ne l'acceptent pas.)
OPENAI_REASONING_EFFORT=xhigh

# Dictée vocale locale (Whisper via transformers.js, exécuté dans le navigateur).
# Optionnel — valeurs par défaut ci-dessous. Modèles plus légers : Xenova/whisper-tiny,
# plus précis : Xenova/whisper-small. La langue accélère et fiabilise la transcription.
NEXT_PUBLIC_WHISPER_MODEL=Xenova/whisper-base
NEXT_PUBLIC_WHISPER_LANG=french

# --- Notifications push (Web Push / VAPID) ---
# Génère tes clés avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@exemple.com

# Secret partagé cron <-> /api/cron/reminders (en-tête Authorization: Bearer <secret>).
CRON_SECRET=

# --- Authentification par passkey (WebAuthn / Face ID) ---
# rpID = domaine exact (sans schéma ni port), ex. agenda.mondomaine.fr. En local : localhost
WEBAUTHN_RP_ID=localhost
# Origin complet, ex. https://agenda.mondomaine.fr. En local : http://localhost:3111
WEBAUTHN_ORIGIN=http://localhost:3111
# Secret de signature des sessions : openssl rand -hex 32
SESSION_SECRET=
# Code exigé pour enrôler un nouvel appareil (une fois par appareil) : openssl rand -hex 4
ENROLL_CODE=
SESSION_DAYS=30
