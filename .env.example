# ============================ FOURNISSEUR LLM ============================
# LE SEUL RÉGLAGE À CHANGER POUR BASCULER DE MODÈLE. Renseigne la clé du
# fournisseur choisi plus bas, et c'est tout : le modèle, l'URL et le format
# d'API suivent automatiquement.
#
#   openai | chatgpt   → GPT (API Responses : raisonnement + outils)
#   claude | anthropic → Claude (API Messages, raisonnement étendu)
#   mistral            → Mistral
#   deepseek           → DeepSeek
#   openai-compat      → tout endpoint /chat/completions — voir la section
#     alias : local, localmodel, ollama, qwen, groq, openrouter, together
LLM_PROVIDER=openai

# --- Clés API : seule celle du provider actif est lue ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- Modèles : facultatif, chaque provider a un défaut raisonnable ---
# Défauts : gpt-5.6-terra · claude-sonnet-5 · mistral-large-latest · deepseek-chat
OPENAI_MODEL=gpt-5.6-terra
# ANTHROPIC_MODEL=claude-sonnet-5
# MISTRAL_MODEL=mistral-large-latest
# DEEPSEEK_MODEL=deepseek-chat

# Surcharge globale, tous providers confondus (prioritaire sur les lignes ci-dessus).
# LLM_MODEL=

# Un modèle par rôle si besoin (prioritaire sur LLM_MODEL).
# LLM_MODEL_PLANNER=   # Josiane (agenda) : raisonnement spatio-temporel
# LLM_MODEL_COACH=     # Jannik (sport)
# LLM_MODEL_WORK=      # Emilien (travail)
# LLM_MODEL_LEISURE=   # Djimo (loisir)
# LLM_MODEL_CHEF=      # Simone (cuisine)

# --- Endpoint OpenAI-compatible (LLM_PROVIDER=openai-compat) ---
# Ex. Ollama local : http://localhost:11434/v1 avec LLM_MODEL=qwen2.5:14b
# (la clé est facultative sur un serveur local).
# LLM_BASE_URL=
# LLM_API_KEY=

# --- Réglages fins (facultatifs) ---
# Effort de raisonnement : none|low|medium|high|xhigh|max.
# Appliqué tel quel par OpenAI, traduit en budget de tokens par Claude,
# ignoré par Mistral/DeepSeek qui n'ont pas ce réglage.
LLM_REASONING_EFFORT=xhigh
# LLM_REASONING_EFFORT_CHAT=medium      # boucle de chat : plus léger, plus rapide
# LLM_REASONING_EFFORT_RETOUCH=high     # retouche ciblée d'un plan
# LLM_MAX_TOKENS=8192                   # plafond de sortie (obligatoire chez Claude)
# LLM_TIMEOUT_MS=600000                 # timeout d'un appel

# Dictée vocale locale (Whisper via transformers.js, exécuté dans le navigateur).
# Optionnel — valeurs par défaut ci-dessous. Modèles plus légers : Xenova/whisper-tiny,
# plus précis : Xenova/whisper-small. La langue accélère et fiabilise la transcription.
NEXT_PUBLIC_WHISPER_MODEL=Xenova/whisper-base
NEXT_PUBLIC_WHISPER_LANG=french

# --- Notifications push (Web Push / VAPID) ---
# Génère tes clés avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@exemple.com

# Secret partagé cron <-> /api/cron/reminders (en-tête Authorization: Bearer <secret>).
CRON_SECRET=

# --- Authentification par passkey (WebAuthn / Face ID) ---
# rpID = domaine exact (sans schéma ni port), ex. agenda.mondomaine.fr. En local : localhost
WEBAUTHN_RP_ID=localhost
# Origin complet, ex. https://agenda.mondomaine.fr. En local : http://localhost:3111
WEBAUTHN_ORIGIN=http://localhost:3111
# Secret de signature des sessions : openssl rand -hex 32
SESSION_SECRET=
# Code exigé pour enrôler un nouvel appareil (une fois par appareil) : openssl rand -hex 4
ENROLL_CODE=
SESSION_DAYS=30
# true = désactive complètement l'auth passkey (accès direct à l'agenda).
# DÉVELOPPEMENT LOCAL UNIQUEMENT — jamais en prod.
AUTH_DISABLED=false

# --- Google Calendar (optionnel, voir GOOGLE.md) ---
# Identifiants OAuth « Application Web » créés dans la console Google Cloud.
# Sans eux, la section Google Calendar des réglages reste inactive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redirection, EXACTEMENT celle déclarée dans la console. Par défaut :
# WEBAUTHN_ORIGIN + /api/google/callback (ex. http://localhost:3002/api/google/callback).
# GOOGLE_REDIRECT_URI=
# Fuseau des événements de l'agenda (les ISO locaux sans fuseau sont lus dans ce fuseau).
# GOOGLE_TIMEZONE=Europe/Paris
# Passage automatique toutes les N minutes (défaut 5).
# GOOGLE_SYNC_INTERVAL_MIN=5
# Fenêtre glissante synchronisée, en jours (défauts : 14 en arrière, 90 en avant).
# GOOGLE_SYNC_PAST_DAYS=14
# GOOGLE_SYNC_FUTURE_DAYS=90
