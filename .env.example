# Clé API Mistral — récupérable sur https://console.mistral.ai/
MISTRAL_API_KEY=

# Modèles par rôle. Petit modèle par défaut pour le chat/CRUD/dates et pour
# la plupart des membres du Conseil ; gros modèle réservé à Josiane (l'agenda),
# qui fait le raisonnement spatio-temporel et l'arbitrage.
# MISTRAL_MODEL reste accepté comme repli pour MISTRAL_MODEL_SMALL.
MISTRAL_MODEL_SMALL=mistral-small-latest
MISTRAL_MODEL_PLANNER=mistral-large-latest
MISTRAL_MODEL_COACH=mistral-small-latest
MISTRAL_MODEL_WORK=mistral-small-latest
MISTRAL_MODEL_LEISURE=mistral-small-latest
MISTRAL_MODEL_CHEF=mistral-small-latest

# Dictée vocale locale (Whisper via transformers.js, exécuté dans le navigateur).
# Optionnel — valeurs par défaut ci-dessous. Modèles plus légers : Xenova/whisper-tiny,
# plus précis : Xenova/whisper-small. La langue accélère et fiabilise la transcription.
NEXT_PUBLIC_WHISPER_MODEL=Xenova/whisper-base
NEXT_PUBLIC_WHISPER_LANG=french
